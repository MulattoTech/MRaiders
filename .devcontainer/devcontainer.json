{
  "name": "MRaiders — Native C++20/Qt cloud workspace",
  "image": "mcr.microsoft.com/devcontainers/cpp:1-bookworm",
  "postCreateCommand": "bash scripts/bootstrap-codespace.sh",
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "editor.formatOnSave": true,
        "cmake.generator": "Ninja",
        "cmake.buildDirectory": "${workspaceFolder}/build"
      },
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools",
        "editorconfig.editorconfig"
      ]
    }
  }
}
