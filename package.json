{
  "name": "arc-raiders-hurricane-overlay",
  "version": "1.0.0",
  "description": "Safe static-data Electron overlay for Arc Raiders Hurricane and First Wave cache routes.",
  "main": "main.js",
  "scripts": {
    "start": "node ./scripts/launch-electron.js .",
    "dev": "node ./scripts/launch-electron.js .",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test",
    "validate:data": "node ./scripts/validate-data.js",
    "smoke": "node ./scripts/smoke.js",
    "build": "electron-builder --dir",
    "build:win": "electron-builder --win portable"
  },
  "keywords": [
    "arc-raiders",
    "electron",
    "overlay",
    "static-data",
    "safe-companion"
  ],
  "author": "OpenAI Codex",
  "license": "MIT",
  "build": {
    "appId": "com.openai.arc-raiders-static-cache-overlay",
    "productName": "Arc Raiders Hurricane Overlay",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "assets/**/*",
      "data/**/*",
      "lib/**/*",
      "scripts/**/*",
      "index.html",
      "main.js",
      "preload.js",
      "renderer.js",
      "styles.css",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "arc-raiders-hurricane-overlay-${version}.${ext}"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "electron": "41.10.6",
    "electron-builder": "^26.8.1",
    "eslint": "^10.2.1",
    "globals": "^17.5.0",
    "prettier": "^3.8.3"
  },
  "dependencies": {
    "electron-store": "11.0.2",
    "electron-window-state": "5.0.3"
  }
}
